surface = input("Введите тип поверхности (помещение / грунт): ")
environment = input("Введите условия (простое / сухо / другое): ")

if surface == "помещение":
    if environment == "простое":
        print("Шасси: Колеса")
        print("Датчик: Ультразвуковой")
    else:
        print("Шасси: Колеса Omni")
        print("Датчик: Лидар")

elif surface == "грунт":
    if environment == "сухо":
        print("Шасси: Полный привод")
        print("Датчик: GPS")
    else:
        print("Шасси: Гусеницы")
        print("Датчик: Датчик пробуксовки")

else:
    print("Шасси: Модульное")
    print("Датчик: Камера")
